# scripts/lib holds tracked source modules; the generic Python `lib/` rule above must not hide them.
!scripts/lib/
!scripts/lib/**

# Miniflare/wrangler local cache produced by local emulation test runs.
.wrangler/

# FactSet Earnings Insight raw PDFs: 115MB of public re-downloadable archive.
# The fetch receipt (URL + sha256 per issue) is committed at
# data/computed/feno-rim-v2/x3-factset-fetch-receipt.json, so the set is
# reproducible without carrying the bytes in a repo already fighting size.
data/factset-earnings-insight/archives/*.pdf

# R1 raw EDGAR/Yahoo caches: re-fetchable via scripts/feno-rim-recovery/r1-fetch-*.mjs;
# only the derived panel + validation artifacts and receipts are committed.
data/edgar/r1-panel/
data/edgar/r2-panel/
data/edgar/r3-panel/

# Third-party published papers: method sources, never redistributable.
# This repository is PUBLIC, so a tracked copy is a public copy.
# Originals live on the SSD with a receipt at
# data/computed/feno-rim-recovery/fetch-receipts/literature-preservation-receipt.json
data/edgar/literature/
