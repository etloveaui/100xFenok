# Local temporary screenshots / scratch artifacts
_tmp/
_verification_screenshots/
100xfenok-next/_verification_screenshots/

# Lighthouse temp artifacts (WSL/Chrome runtime)
100xfenok-next/*lighthouse.*/
100xfenok-next/*lighthouse.*/**

# Git Artifacts
.git-rewrite/

# Large binary data (removed from history via git filter-repo)
*.xlsb

# Official Russell factsheet history keeps immutable local raw PDFs; dated JSON
# receipts remain trackable while the binary source stays outside Git.
data/computed/fenok-rim/russell2000-history/*.pdf

# Local Next.js build backups
100xfenok-next/.next_prev_*/

# Build-artifact mirrors regenerated by `npm run sync-static` (package.json build:runtime/predev).
# Source-of-truth lives in ../tools and ../data; these public/ copies are rebuilt every build/dev.
100xfenok-next/public/tools/stock_analyzer/data/global_scouter_integrated.json
100xfenok-next/public/data/sec-13f/investors/griffin.json
100xfenok-next/public/data/sentiment/
100xfenok-next/public/data/winddown/
# US indices public copies are materialized by Update Manifest from data/indices/.
100xfenok-next/public/data/indices/
# Damodaran public copies are exact-mirrored by Update Manifest from data/damodaran/ (delete:true rsync_tree).
100xfenok-next/public/data/damodaran/
# Global Scouter derived public copies are materialized by Update Manifest from canonical data/global-scouter/core outputs.
100xfenok-next/public/data/global-scouter/core/stocks_analyzer.json
