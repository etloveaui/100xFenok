{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "100xfenok",
  "main": "worker.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "MONA_VNEXT_KV",
      "id": "9ca9cc74a4f341aeaa231fa67db65302",
      "preview_id": "67dd8748c45d4cce9770f1bf761ecaa4"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WINDDOWN_REVIEW_COORDINATOR",
        "class_name": "WindDownReviewCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-winddown-review-coordinator",
      "new_sqlite_classes": [
        "WindDownReviewCoordinator"
      ]
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DATA_SUPPLY_ANALYTICS",
      "dataset": "fenok_data_supply_unavailable"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "100xfenok"
    }
  ],
  "ratelimits": [
    {
      "name": "RL_GLOBAL",
      "namespace_id": "1001001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "RL_API",
      "namespace_id": "1001002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_ADMIN",
      "namespace_id": "1001003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
