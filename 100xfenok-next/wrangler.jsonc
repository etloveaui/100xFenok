{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "100xfenok",
  "main": "worker.ts",
  // Apply the same final minification in budget dry-runs and production uploads.
  // Preserve function/class names used by runtime bindings and diagnostics.
  "minify": true,
  "keep_names": true,
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    // These patterns are derived from the generated public enrollment
    // authority, with the isolated private Griffin deny route and the
    // isolated admin design-lab screenshots route (admin-session gated by
    // middleware, not the data plane) retained explicitly. The `*` is a
    // deep glob. Every unhealthy data-plane outcome still falls back to
    // this same asset directory.
    "run_worker_first": [
      "/data/computed/*",
      "/data/damodaran/*",
      "/data/earnings-overview/*",
      "/data/edgar-korean-summaries/*",
      "/data/global-scouter/*",
      "/data/indices/*",
      "/data/macro/*",
      "/data/sentiment/*",
      "/data/slickcharts/*",
      "/data/yardney/*",
      "/data/sec-13f/investors/griffin.json",
      "/admin/design-lab/screenshots/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "MONA_VNEXT_KV",
      "id": "9ca9cc74a4f341aeaa231fa67db65302",
      "preview_id": "67dd8748c45d4cce9770f1bf761ecaa4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA_PLANE_BUCKET",
      "bucket_name": "fenok-data-plane"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WINDDOWN_REVIEW_COORDINATOR",
        "class_name": "WindDownReviewCoordinator"
      },
      {
        "name": "CLOUD_DATA_PLANE_COORDINATOR",
        "class_name": "CloudDataPlaneCoordinator"
      },
      {
        "name": "USER_STORE",
        "class_name": "UserStore"
      },
      {
        "name": "USER_REGISTRY",
        "class_name": "UserRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-winddown-review-coordinator",
      "new_sqlite_classes": [
        "WindDownReviewCoordinator"
      ]
    },
    {
      "tag": "v2-cloud-data-plane-coordinator",
      "new_sqlite_classes": [
        "CloudDataPlaneCoordinator"
      ]
    },
    {
      "tag": "v3-user-store",
      "new_sqlite_classes": [
        "UserStore"
      ]
    },
    {
      "tag": "v4-user-registry",
      "new_sqlite_classes": [
        "UserRegistry"
      ]
    }
  ],
  "vars": {
    "CLOSED_SITE": "intro",
    "GOOGLE_CLIENT_ID": "1047143661358-ppe3u3k58dcbi59usbkmd0fggbi5dkpd.apps.googleusercontent.com"
  },
  "analytics_engine_datasets": [
    {
      "binding": "DATA_SUPPLY_ANALYTICS",
      "dataset": "fenok_data_supply_unavailable"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "100xfenok"
    }
  ],
  "ratelimits": [
    {
      "name": "RL_GLOBAL",
      "namespace_id": "1001001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "RL_API",
      "namespace_id": "1001002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_ADMIN",
      "namespace_id": "1001003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
