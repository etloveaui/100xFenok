    "algorithm": {
      "id": "fenok-rim-sustainable-index-calibration",
      "parameters": {
        "lt_roe_rule": {
          "anchor": "the index's own rolling 260-week median forward ROE",
          "cross_family_bridge": "the stock sheets contribute the large-gap regime only; their implied gap share of 0.622~0.756 brackets the share the index rows imply, which is the measured agreement that licenses the transfer",
          "equation": "LTROE_centre = median_260w + 0.070661 + 0.471304 * max(forward_ROE - median_260w, 0)",
          "fit_dates": [
            "2025-12-09",
            "2026-08-03"
          ],
          "fit_observables": "printed LTROE axis centres only: three from the 2025-12-09 index sheets and four from the 2026-08-03 Samsung and SK Hynix scenarios. No published upside is inverted into the fit, which leaves both two-sided claims free to evaluate it.",
          "gap_coefficient": 0.471304,
          "intercept": 0.070661,
          "lattice_half_width": 0.005,
          "lattice_note": "Yoo prints a +/-0.5pp LTROE axis; the same half width is retained"
        },
        "payout_multiplier": {
          "center": 1.08574,
          "derivation": "direct index payout over raw tracker ratio on the same basis, both sides being dividend yield over forward earnings yield, measured on the S&P 500 and the NASDAQ 100 where the tracker really is the index",
          "high": 1.0866,
          "low": 1.08488,
          "observations": 2,
          "rejected": "a universal scalar fitted to the printed/grid/LSEG payouts, which are trailing realised or inverted quantities and not the same variable as a tracker distribution yield",
          "swept": "the low and high multipliers are swept into the published endpoints so the measured divergence is visible rather than hidden"
        },
        "printed_convexity_domain": {
          "basis": "every printed LTROE axis value times one minus the grid-fitted payout, over d(Rf), across both printed rate scenarios",
          "high": 2.5573573388074213,
          "low": 1.7686871045010335,
          "observations": 12,
          "source": "scripts/fixtures/fenok-rim-2025-12-09-grid.json"
        },
        "twelve_month_conversion": {
          "basis": "median of the per-anchor scale that lands the fair-value band on his published upside, over the seven dated RIM claims",
          "high": 1.114,
          "horizon_months": 12,
          "intercept_rejected": "a fitted intercept collapses every index onto the sample mean and destroys the ordering the model exists to produce",
          "low": 0.3,
          "observations": 7,
          "share": 0.696
        }
      },
